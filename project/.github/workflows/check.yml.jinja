---
# Runs the gate (scripts/check.sh, wt.gate) with --strict: every tool the gate needs is
# installed here, so a skipped step fails. CI adds nothing the gate doesn't check (C5.2).
# Actions are pinned to full commit SHAs (tag in the comment); Dependabot proposes updates.
name: check

on:
  push:
    branches: [{{ base }}]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: check-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  gate:
{%- if project_type == 'python' %}
    name: gate (Python {% raw %}${{ matrix.python }}{% endraw %})
{%- else %}
    name: gate
{%- endif %}
    runs-on: ubuntu-latest
    timeout-minutes: 15
{%- if project_type == 'python' %}
    strategy:
      fail-fast: false
      matrix:
        # Oldest supported and newest stable.
        python: ["{{ python_min }}", "3.14"]
    env:
      UV_PYTHON: {% raw %}${{ matrix.python }}{% endraw %}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.12.13"
          enable-cache: true
          # Tool pins live in scripts/check.sh{% if project_type == 'python' %}; dependencies in uv.lock{% endif %}.
          cache-dependency-glob: |
            scripts/check.sh
{%- if project_type == 'python' %}
            uv.lock
{%- endif %}
{%- if project_type == 'bash' %}

      - name: Install bats-core (pinned, checksum verified)
        env:
          BATS_VERSION: "1.14.0"
          BATS_SHA256: bb537b70b15b732f6d8827dd6578e3d8ce166636ce1f18ea9a074184fcce9177
        run: |
          curl -fsSL -o "$RUNNER_TEMP/bats.tar.gz" "https://github.com/bats-core/bats-core/archive/refs/tags/v${BATS_VERSION}.tar.gz"
          echo "${BATS_SHA256}  $RUNNER_TEMP/bats.tar.gz" | sha256sum -c -
          tar -xzf "$RUNNER_TEMP/bats.tar.gz" -C "$RUNNER_TEMP"
          sudo "$RUNNER_TEMP/bats-core-${BATS_VERSION}/install.sh" /usr/local
{%- endif %}
{%- if project_type == 'terraform' %}

      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: "1.16.6"
          terraform_wrapper: false

      - uses: terraform-linters/setup-tflint@6ffdbaa3be476b3431f7275c26966ef32ff60337 # v6.3.2
        with:
          tflint_version: v0.64.0
          checksums: cca9d13e2e1d7a2c627af60ff899a3c9b74212899416aeb96ec764d2ef954537
{%- endif %}
{%- if project_type == 'docker' %}

      # Docker Engine and the Compose plugin come with the ubuntu-latest image.
      - name: Docker versions
        run: |
          docker version --format '{% raw %}{{ .Server.Version }}{% endraw %}'
          docker compose version
{%- endif %}

      - name: Run gate
        run: scripts/check.sh --strict

      - name: Gate left the tree clean
        run: |
          git status --porcelain
          test -z "$(git status --porcelain)"
